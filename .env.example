# Copy to .env and fill in the key supplied for your gateway.
AI_API_URL=https://tokendance.space/gateway/v1/chat/completions
AI_API_KEY=
# Change this if your gateway uses a different model name.
AI_MODEL=deepseek-v4-flash
PORT=4317

# Optional: live AMap (Gaode) map. Keep the security code on the server.
# Create a Web (JS API) key and its security code in the AMap developer console.
AMAP_WEB_KEY=
AMAP_SECURITY_CODE=
# Optional second key: create a separate "Web服务 API" key for place search and walking routes.
AMAP_SERVICE_KEY=
# If using DeepSeek, use these values instead:
# AI_API_URL=https://api.deepseek.com/chat/completions
# AI_MODEL=deepseek-flash
